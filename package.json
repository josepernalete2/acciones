{
  "name": "acciones",
  "version": "1.0.0",
  "description": "Sistema Backend para gestión de portafolio bursátil enfocado en la Bolsa de Valores de Caracas (BVC), tasas de cambio (BCV, Binance USDT) y control de custodia",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "bvc",
    "bolsa-de-valores-de-caracas",
    "bcv",
    "binance-p2p",
    "portfolio-tracker",
    "typescript",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "josepernalete2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/josepernalete2/acciones.git"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
